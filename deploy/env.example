# 이 파일을 .env 로 복사해서 값을 채우세요:  cp env.example .env && vi .env
# ⚠️ .env 는 비밀 파일이에요. git에 올리거나 남에게 보여주지 마세요.

# DuckDNS 에서 만든 주소 (.duckdns.org 까지 전체)
PROD_DOMAIN=myblog.duckdns.org
TEST_DOMAIN=myblog-test.duckdns.org

# DuckDNS 주소 이름만 쉼표로 (.duckdns.org 빼고)
DUCKDNS_SUBDOMAINS=myblog,myblog-test
# DuckDNS 화면 위쪽의 token
DUCKDNS_TOKEN=여기에-토큰

# 관리자 비밀번호 (처음 실행할 때만 적용)
PROD_ADMIN_PASSWORD=운영-관리자-비밀번호
TEST_ADMIN_PASSWORD=테스트-관리자-비밀번호

# API 키 암호화용 비밀값 → 아래 명령으로 만들어서 붙여넣기:  openssl rand -base64 32
# ⚠️ 한번 정하면 절대 바꾸지 마세요 (바꾸면 회원들이 API 키를 다시 등록해야 함)
PROD_APP_SECRET=
TEST_APP_SECRET=
